{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "next dev -p 3310",
    "build": "next build",
    "start": "next start -p 3310",
    "lint": "next lint",
    "typecheck": "node scripts/ensure-next-env.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "qa": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "chat:backfill": "node scripts/chat-backfill.js",
    "packages:build": "pnpm --filter '@snapie/*' build",
    "packages:publish": "pnpm packages:build && pnpm --filter '@snapie/*' publish --access public"
  },
  "dependencies": {
    "@aioha/aioha": "^1.8.5",
    "@aioha/react-ui": "^1.8.2",
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@giphy/js-fetch-api": "^5.6.0",
    "@giphy/js-types": "^5.1.0",
    "@giphy/react-components": "^9.6.0",
    "@hiveio/content-renderer": "^2.3.1",
    "@hiveio/dhive": "1.3.1-beta",
    "@livekit/components-react": "^2.9.20",
    "@mantequilla-soft/3speak-player": "^0.3.2",
    "@snapie/composer": "workspace:*",
    "@snapie/hangouts-core": "^0.11.1",
    "@snapie/hangouts-react": "^0.19.1",
    "@snapie/operations": "workspace:*",
    "@snapie/renderer": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^11.3.28",
    "franc-min": "^6.2.0",
    "isomorphic-dompurify": "^2.31.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "keychain": "^1.5.0",
    "livekit-client": "^2.18.0",
    "mongoose": "^9.6.3",
    "next": "15.5.27",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.3.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intersection-observer": "^10.0.0",
    "react-qr-code": "^2.2.0",
    "react-virtuoso": "^4.18.7",
    "sharp": "^0.35.5",
    "styled-components": "^6.1.19",
    "swiper": "^12.0.3",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.27",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "jsdom": "^24.0.0",
      "glob": "10.5.0",
      "dompurify": "3.4.16",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    },
    "patchedDependencies": {
      "@hiveio/content-renderer@2.3.1": "patches/@hiveio__content-renderer@2.3.1.patch"
    }
  },
  "optionalDependencies": {
    "@mantequilla-soft/butrauth-client": "^0.6.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
