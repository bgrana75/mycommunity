# =============================================================================
# Feed-only local / dev
#
#   cp .env.local.example .env.local
#
# That is enough to boot the feed. MongoDB is not required. Chat routes fail
# only when something actually calls them.
#
# CHAT_JWT_SECRET must be non-empty even for `pnpm build` / `next build`.
# lib/chat/auth.ts throws at import if it is missing, and Next.js loads that
# module while collecting page data. CI sets CHAT_JWT_SECRET=ci-build-placeholder
# for the same reason. The value below is a local placeholder, not a
# credential. Replace it in any shared or deployed environment.
# Do not commit .env.local or real secrets.
# =============================================================================

CHAT_JWT_SECRET=local-dev-not-a-secret

NEXT_PUBLIC_THEME=nounish

# Hold /_next/static scripts until the home LCP image has painted.
# On unless set to exactly 0. Unset rewrites the home document only.
# SNAPIE_DEFER_FRAMEWORK_SCRIPTS=0

# Serve lib/hive/pinnedHomeFeed.json instead of the live Hive feed.
# Measurement only. Unset uses the live feed.
# SNAPIE_PINNED_FEED=1
NEXT_PUBLIC_HIVE_COMMUNITY_TAG=hive-167980
NEXT_PUBLIC_HIVE_SEARCH_TAG=hive-167980
NEXT_PUBLIC_HIVE_USER=skatedev
NEXT_PUBLIC_DISPLAY_CURRENCY=
NEXT_PUBLIC_HIVESIGNER_ENABLED=false

# Snapie Auth proxy. Feed works if this server is down. Dev default is
# http://localhost:3500; production is https://auth.snapie.io.
SNAPIE_AUTH_URL=http://localhost:3500
# Server-side key for /api/internal/* calls. Leave empty locally.
SNAPIE_AUTH_INTERNAL_KEY=

# Optional server-side account utilities (only if using account-create helpers)
# ACCOUNT_CREATOR=your_creator_account
# ACCOUNT_KEY=your_creator_private_key
# Account that receives posting authority on every new account created via the faucet or sponsor flow.
# Defaults to 'snapie' if not set.
NEXT_PUBLIC_POSTING_AUTHORITY_ACCOUNT=snapie
# Account that receives HBD for Snapie Points purchases (Buy Points). Must be
# an account this NEXT_PUBLIC_ value AND the server both agree on — it's read
# both client-side (transfer destination) and server-side (on-chain transfer
# verification), and being NEXT_PUBLIC_ it's inlined at BUILD time, so
# changing it requires a rebuild, not just a runtime restart.
# Defaults to 'snapie' if not set.
NEXT_PUBLIC_POINTS_RECEIVING_ACCOUNT=snapie

# Hive activity sidecar. Not required for local dev — routes that depend on
# it degrade gracefully. See internal-docs/hive-activity-sidecar.md.
HIVE_ACTIVITY_SIDECAR_URL=http://127.0.0.1:3099
# Soft-launch gate for blending waves into the "Latest" feed. If the sidecar
# /feed endpoint is down, "Latest" falls back to snaps-only.
NEXT_PUBLIC_ENABLE_BLENDED_FEED=false

# Discovery Engine. Build-time flag (baked in by `pnpm build`).
# See internal-docs/discovery-engine-grand-plan.md.
NEXT_PUBLIC_ENABLE_DISCOVERY_SNAPS=false

# Snapie Points earning features. Independent rollout switches.
# Snapie Blocks needs NEXT_PUBLIC_ENABLE_GAMES, NEXT_PUBLIC_ENABLE_POINTS,
# and MONGODB_URI. Docker Compose sets those for a local preview; this
# feed-only file leaves them off. Wins pay a flat server award, not a score.
NEXT_PUBLIC_ENABLE_POINTS=false
NEXT_PUBLIC_ENABLE_POINTS_ROULETTE=false
NEXT_PUBLIC_ENABLE_POINTS_MARKET=false
NEXT_PUBLIC_ENABLE_GAMES=false

# Comma-separated Hive usernames allowed to use /settings/admin/heal-purchase.
# Checked against the signature-verified chat session username.
ADMIN_HIVE_USERNAMES=

# Translation (LibreTranslate). Leave LIBRETRANSLATE_URL blank to hide the
# translate button. Self-hosted example: http://localhost:5000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=

# In-app feedback opens a GitHub issue in Mantequilla-Soft/snapie-io.
# Server-only. Never use a NEXT_PUBLIC_ name — the browser must not see this
# token. Leave GITHUB_FEEDBACK_TOKEN unset to disable submissions; the form
# shows a friendly error. The token needs permission to create issues and
# labels (fine-grained: Issues read and write on this repo).
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=Mantequilla-Soft/snapie-io

# Optional media keys. Uploads and GIF search are not required for the feed.
# NEXT_PUBLIC_3SPEAK_API_KEY=
# NEXT_PUBLIC_IMAGE_SERVER_API_KEY=
# GIF search uses NEXT_PUBLIC_GIPHY_API_KEY or GIPHY_API_KEY when set.
# NEXT_PUBLIC_GIPHY_API_KEY=
# GIPHY_API_KEY=

# available themes -> bluesky, hacker, forest, cannabis, mengao, nounish, hivebr, windows95
# available currencies -> BRL, EUR, GBP, JPY, AUD, CAD, CHF, CNY, INR (leave empty for HBD/USD)

# =============================================================================
# Chat profile (hangouts + chat)
#
# Feed-only: leave MONGODB_URI unset. Chat does not connect.
#
# When chat is needed, set MONGODB_URI to your MongoDB instance, for example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/snapiechat
#
# MONGODB_DB_NAME defaults to snapiechat in code when unset.
# Hangouts URLs below are public endpoints. They do not need Mongo. Opening
# a hangout uses them; chat channels, DMs, and groups need Mongo as well.
# =============================================================================

# MONGODB_URI=mongodb://127.0.0.1:27017/snapiechat
# MONGODB_DB_NAME=snapiechat
NEXT_PUBLIC_CHAT_DEFAULT_CHANNEL=general

# Hangouts (OpenPods) + LiveKit. Public endpoints; required to open hangouts.
NEXT_PUBLIC_HANGOUTS_API_URL=https://hangout-api.3speak.tv
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.3speak.tv
# Where to persist the hangouts session JWT. Default 'none' (re-sign every
# visit). 'session' survives reloads in the same tab. 'local' survives browser
# restarts but is XSS-readable for up to the JWT TTL (~24h).
NEXT_PUBLIC_HANGOUTS_TOKEN_STORAGE=none

# Optional: chat sign-in with ButrAuth access tokens (warm-up users). Needs
# @mantequilla-soft/butrauth-client >= 0.6.0 installed. See README.
# BUTRAUTH_URL=https://butrauth.com
# BUTRAUTH_CHAT_AUDIENCES=your-app-client-id
# BUTRAUTH_ISSUER=butrauth

# Firebase Cloud Messaging (optional — chat works without push notifications).
# Encode a service account JSON with: base64 -w0 service-account.json
# FIREBASE_SERVICE_ACCOUNT=
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Where the Butter Factory (the /factory page) is published. https only, or http on localhost.
# Defaults to https://factory-island-sim.lovable.app. Set it when the factory moves to its own domain.
# NEXT_PUBLIC_FACTORY_URL=
